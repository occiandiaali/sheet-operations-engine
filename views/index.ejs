      <span id="file-name-display" class="file-name-display">No file selected (.xlsx, .xls, .csv)</span>
    </div>
  </label>

  <!-- Native file input linked via "for=targetFile" -->
  <input type="file" id="targetFile" name="targetFile" style="display: none;" required accept=".xlsx, .xls, .csv">

      <div style="height: 24px;"></div>
