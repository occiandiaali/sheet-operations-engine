  <hr />
  <h2>🛡️ Column Masking (Scrub)</h2>
  <p style="color:#475569;">Redact a highly sensitive column before sharing with others.</p>
  <form hx-post="/api/mask" hx-encoding="multipart/form-data" hx-target="#mask-output" hx-indicator="#mask-loader">
  <label><strong>Target Spreadsheet</strong></label>

  <!-- HTML label triggers the file input natively without JS dependencies -->
  <label for="targetFile" id="drop-zone" class="drop-zone">
    <div class="drop-zone-content">
      <span class="drop-zone-icon">📁</span>
