    /* Hide loaders by default */
.auth-indicator {
  display: none;
  /* color: #2563eb; */
  color: #bb5e08;
  font-size: 14px;
  font-weight: 500;
  margin-top: 10px;
  text-align: center;
}

/* HTMX automatically displays the loader when processing takes place */
.htmx-request + .auth-indicator,
.htmx-request.auth-indicator {
  display: block !important;
}

/* Force HTMX indicators to show up when their parent form is executing a request */
.htmx-request + .htmx-indicator,
.htmx-request.htmx-indicator {
  display: block !important;
}

/* Dim the submit button while loading to prevent double-clicks */
.htmx-request button[type="submit"] {
  background: #94a3b8 !important;
  cursor: not-allowed;
  pointer-events: none;
}

