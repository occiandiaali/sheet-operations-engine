      <div class="card" id="diff-section">
  <h2>🔍 Version Comparison Engine (Diff)</h2>
  <p style="color:#475569;">Upload two versions of a spreadsheet to instantly cross-reference row changes.</p>
  <form hx-post="/api/diff" hx-encoding="multipart/form-data" hx-target="#diff-output" hx-indicator="#diff-loader">
    <label><strong>Original Sheet (v1)</strong></label>
    <input type="file" name="fileA" required>
    <label><strong>Modified Sheet (v2)</strong></label>
    <input type="file" name="fileB" required>
    <button type="submit">Analyze</button>
  </form>
  <div id="diff-loader" class="htmx-indicator">Parsing sheets and calculating diffs...</div>
  <div id="diff-output"></div>
</div>

<div class="card" id="mask-section">
  <h2>🛡️ Column Masking (Scrub)</h2>
  <p style="color:#475569;">Redact a highly sensitive column before sharing with others.</p>
  <form hx-post="/api/mask" hx-encoding="multipart/form-data" hx-target="#mask-output" hx-indicator="#mask-loader">
    <label><strong>Target Spreadsheet</strong></label>
    <input type="file" name="targetFile" required>
    <!-- <label><strong>Column Name to Redact</strong> (Case sensitive, e.g., <em>Annual Salary (USD)</em>)</label>
    <input type="text" name="columnName" placeholder="Annual Salary (USD)" required> -->
    <label><strong>Column Name(s) to Redact</strong> (e.g., <em>Annual Salary (USD), Full Name</em>)</label>
<input type="text" name="columnName" placeholder="Separate multiple names with commas" required>
    <button type="submit" style="background:#0f766e;">Scrub &amp; Save View</button>
  </form>
  <div id="mask-loader" class="htmx-indicator">Executing server-side scrubbing loop...</div>
  <div id="mask-output"></div>
</div>
    </div>
