      name="description"
      content="Redact, encrypt, and share your spreadsheets securely. SheetScrub helps businesses manage sensitive data and comply with GDPR & HIPAA effortlessly."
    />
    <meta
      name="keywords"
      content="secure spreadsheets, data scrubbing, excel security, redact PII, google sheets privacy, data management app"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Roboto:wght@400;500&display=swap"
